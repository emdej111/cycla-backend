# App
APP_NAME=Cycla API
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://cycla:cycla@localhost:5432/cycla

# JWT / auth
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Field-level encryption at rest — must be a 32-byte urlsafe base64 Fernet key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Personalization
MIN_CYCLES_FOR_PERSONALIZATION=3

# CORS (comma-separated list will be parsed as JSON array by pydantic-settings; use a JSON array string)
CORS_ORIGINS=["*"]

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15
